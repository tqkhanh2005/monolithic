{
  "name": "ecommerce-monolithic",
  "version": "1.0.0",
  "description": "Phase 2 - E-commerce MVP monolith (Express, Prisma, PostgreSQL, JWT)",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
