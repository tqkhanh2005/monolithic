            "exec": [
              "pm.test('HTTP 200',()=>pm.response.to.have.status(200));",
              "pm.test('PENDING',()=>pm.expect(pm.response.json().status).to.eql('PENDING'));"
            ]
          }
        }
      ]
    },
    {
      "name": "Customer cannot change shipment",
      "request": {
        "method": "PATCH",
        "url": "{{baseUrl}}/api/shipments/{{shipid}}/status",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{token}}",
              "type": "string"
            }
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\"status\":\"SHIPPING\"}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 403',()=>pm.response.to.have.status(403));"
            ]
          }
        }
      ]
    },
